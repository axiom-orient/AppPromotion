{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppPromotion catalog v2",
  "type": "object",
  "required": ["schemaVersion", "revision", "enabled", "validUntil", "campaigns"],
  "properties": {
    "schemaVersion": {"const": 2},
    "revision": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "enabled": {"type": "boolean"},
    "validUntil": {"$ref": "#/$defs/utcDate"},
    "campaigns": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/campaign"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
    "utcDate": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "copy": {
      "type": "string",
      "minLength": 1,
      "description": "Runtime also requires nonblank plain text of at most 60 Swift Character values. JSON Schema length counts code points and does not express that grapheme limit."
    },
    "icon": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/v2/assets/[0-9a-f]{64}\\.(png|jpg)$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "campaign": {
      "type": "object",
      "required": ["id", "host", "target", "startsAt", "endsAt", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "host": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "startsAt": {"$ref": "#/$defs/utcDate"},
        "endsAt": {"$ref": "#/$defs/utcDate"},
        "description": {
          "type": "object",
          "required": ["ko", "en"],
          "properties": {
            "ko": {"$ref": "#/$defs/copy"},
            "en": {"$ref": "#/$defs/copy"}
          }
        },
        "icon": {"$ref": "#/$defs/icon"}
      }
    }
  }
}
